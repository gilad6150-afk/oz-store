/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Static media assets - revalidate with server so browser always gets updated images!
/public/*
  Cache-Control: public, max-age=0, must-revalidate

/*.jpg
  Cache-Control: public, max-age=0, must-revalidate

/*.jpeg
  Cache-Control: public, max-age=0, must-revalidate

/*.png
  Cache-Control: public, max-age=0, must-revalidate

/*.webp
  Cache-Control: public, max-age=0, must-revalidate

/*.svg
  Cache-Control: public, max-age=0, must-revalidate

/*.ico
  Cache-Control: public, max-age=0, must-revalidate

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# JavaScript and Data files (revalidate)
/*.js
  Cache-Control: public, max-age=0, must-revalidate

/*.json
  Cache-Control: public, max-age=0, must-revalidate

/*.xml
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

# HTML documents - no-cache so browsers always get fresh DOM
/*.html
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

/status
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

/status/*
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

/
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0
